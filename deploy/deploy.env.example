# Copiar este archivo a .env.deploy en la raiz. Usar una clave local propia.
POSTGRES_PASSWORD=
# Sustituir CONTRASENA por POSTGRES_PASSWORD codificada para una URL.
DATABASE_URL=postgresql://okfamily:CONTRASENA@postgres:5432/okfamily
# MIGRATION_DATABASE_URL=
WEB_ORIGIN=https://localhost:8443
DEPLOY_BIND_IP=127.0.0.1
DEPLOY_HTTPS_PORT=8443
DEPLOY_TLS_DIR=./.data/deploy-tls
DEPLOY_TAG=local

STRIPE_MODE=test
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LOCAL_DELIVERY_RATES_JSON=
