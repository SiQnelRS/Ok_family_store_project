generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

enum ProductType {
  PRODUCTO
  LOTE
}

enum OrderStatus {
  PENDIENTE_PAGO
  PAGADO
  PREPARANDO
  LISTO_PARA_ENVIO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum ReservationStatus {
  ACTIVA
  CONFIRMADA
  LIBERADA
  EXPIRADA
}

enum PaymentStatus {
  PENDIENTE
  EXITOSO
  FALLIDO
  REEMBOLSADO
}

/// Propiedad de Auth. El alta de administradores no será pública.
model User {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  email String @unique @db.VarChar(254)
  passwordHash String?
  phone String? @db.VarChar(20)
  provider AuthProvider @default(EMAIL)
  providerSubject String?
  role UserRole @default(CUSTOMER)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminSessions AdminSession[]
  customerSessions CustomerSession[]

  @@unique([provider, providerSubject])
}

/// Propiedad de Commerce. userId es referencia externa a Auth.
model Address {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  label String @db.VarChar(80)
  recipientName String @db.VarChar(120)
  phone String @db.VarChar(20)
  street String @db.VarChar(180)
  number String @db.VarChar(30)
  neighborhood String @db.VarChar(120)
  postalCode String @db.Char(5)
  city String @db.VarChar(120)
  state String @db.VarChar(120)
  references String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Propiedad de Catalog. Cantidades en unidades comerciales, NO piezas del lote.
model Product {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(180)
  name String @db.VarChar(180)
  description String
  priceInCents Int
  currency String @default("MXN") @db.Char(3)
  category String @db.VarChar(80)
  type ProductType @default(PRODUCTO)
  piecesPerUnit Int @default(1)
  availableQuantity Int @default(1)
  reservedQuantity Int @default(0)
  soldQuantity Int @default(0)
  published Boolean @default(false)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images ProductImage[]
  reservationItems ReservationItem[]

  @@index([published, category])
  @@index([published, createdAt])
}

model ProductImage {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  url String
  alt String @db.VarChar(200)
  sortOrder Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// Reserva y disponibilidad pertenecen a Catalog: todavía sin operación de checkout.
model Reservation {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  userId String @db.Uuid
  idempotencyKey String @unique @db.VarChar(200)
  status ReservationStatus @default(ACTIVA)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items ReservationItem[]

  @@index([status, expiresAt])
}

model ReservationItem {
  id String @id @default(uuid()) @db.Uuid
  reservationId String @db.Uuid
  productId String @db.Uuid
  quantity Int
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([reservationId, productId])
  @@index([productId])
}

/// Propiedad de Commerce. Dirección y precios se conservan como instantáneas.
model Order {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  addressId String? @db.Uuid
  shippingAddressSnapshot Json
  subtotalInCents Int
  shippingInCents Int
  totalInCents Int
  currency String @default("MXN") @db.Char(3)
  status OrderStatus @default(PENDIENTE_PAGO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  operations OrderOperation[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  productId String @db.Uuid
  productName String @db.VarChar(180)
  productType ProductType
  piecesPerUnit Int
  quantity Int
  unitPriceInCents Int
  subtotalInCents Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  stripePaymentId String? @unique
  idempotencyKey String @unique @db.VarChar(200)
  amountInCents Int
  currency String @default("MXN") @db.Char(3)
  status PaymentStatus @default(PENDIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

/// eventId único permite implementar recepción idempotente; no hay webhook activo.
model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  eventId String @unique
  type String
  receivedAt DateTime @default(now())
  processedAt DateTime?
}

/// Sesiones opacas; solo se persiste el hash del token. Propiedad de Auth.
model AdminSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId String @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

/// Historial de Catalog, conservado incluso al eliminar la publicacion.
model ProductAudit {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  actorId String @db.Uuid
  action String @db.VarChar(20)
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
}

model CustomerSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId String @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model CustomerStatusAudit {
  id String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  actorId String @db.Uuid
  active Boolean
  createdAt DateTime @default(now())
  @@index([customerId, createdAt])
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  productId String @db.Uuid
  slug String @db.VarChar(180)
  quantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, slug])
  @@index([userId, createdAt])
}

model OrderOperation {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  actorId String @db.Uuid
  previous OrderStatus
  next OrderStatus
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}
