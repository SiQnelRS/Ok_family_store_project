# Desarrollo local. Copiar a .env; nunca subir secretos.
NODE_ENV=development
DATABASE_URL=postgresql://okfamily:okfamily_local@127.0.0.1:55432/okfamily?schema=public
WEB_ORIGIN=http://localhost:3000
SERVICE_HOST=127.0.0.1
API_GATEWAY_URL=http://127.0.0.1:4000
GATEWAY_PORT=4000
AUTH_PORT=4001
CATALOG_PORT=4002
COMMERCE_PORT=4003
AUTH_SERVICE_URL=http://127.0.0.1:4001
CATALOG_SERVICE_URL=http://127.0.0.1:4002
COMMERCE_SERVICE_URL=http://127.0.0.1:4003

# Fotos administrativas: por defecto en .data/uploads/.
# CATALOG_UPLOAD_DIR=C:/ruta/absoluta/fotos

# Tarifas locales por código postal, en centavos. Vacío = cobertura pendiente.
# LOCAL_DELIVERY_RATES_JSON={"34000":8000}

# Stripe Checkout. Mantener las claves en .env local o en el gestor de secretos del hosting.
STRIPE_MODE=test
# Permite pausar nuevas sesiones sin detener webhooks ni conciliación.
# STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Etapas futuras
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OBJECT_STORAGE_URL=
